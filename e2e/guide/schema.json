{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:playwright-e2e-guides:manifest:v1",
  "title": "Playwright guide manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatorVersion",
    "slug",
    "title",
    "description",
    "audience",
    "tags",
    "project",
    "specFile",
    "startedAt",
    "finishedAt",
    "durationMs",
    "viewport",
    "outputDir",
    "steps",
    "status",
    "publishable",
    "validationErrors"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatorVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "slug": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "audience": { "type": "string", "minLength": 1 },
    "estimatedMinutes": { "type": "number", "exclusiveMinimum": 0 },
    "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "project": { "type": "string", "minLength": 1 },
    "specFile": { "type": "string", "minLength": 1 },
    "sourceRevision": { "type": "string", "minLength": 1 },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "durationMs": { "type": "number", "minimum": 0 },
    "viewport": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "outputDir": { "type": "string" },
    "videoPath": { "type": "string" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "title", "url", "startedAt", "durationMs"],
        "properties": {
          "index": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "note": { "type": "string" },
          "screenshot": { "type": "string" },
          "url": { "type": "string" },
          "startedAt": { "type": "string", "format": "date-time" },
          "durationMs": { "type": "number", "minimum": 0 }
        }
      }
    },
    "status": {
      "enum": ["passed", "failed", "timedOut", "skipped", "interrupted", "unknown"]
    },
    "publishable": { "type": "boolean" },
    "validationErrors": { "type": "array", "items": { "type": "string" } }
  }
}
